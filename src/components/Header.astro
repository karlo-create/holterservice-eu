---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

// Nav order is founder-defined (VEY-910): patients tab comes directly after
// the service tab. Keep this identical to the "Stranice" list in Footer.astro.
const nav = [
  { href: '/usluga', label: 'Usluga' },
  { href: '/za-pacijente', label: 'Za pacijente' },
  { href: '/za-partnere', label: 'Za partnere' },
  { href: '/partneri', label: 'Partneri' },
  { href: '/o-nama', label: 'O nama' },
  { href: '/eu-projekt', label: 'Projekt' },
  { href: '/kontakt', label: 'Kontakt' },
];

const isActive = (href: string) => pathname === href;
---

<header class="site-header">
  <div class="container header-inner">
    <!-- Brand / wordmark -->
    <a href="/" class="brand" aria-label="Holterservice, početna">
      <svg class="brand-ecg" width="20" height="14" viewBox="0 0 22 16" fill="none" aria-hidden="true">
        <path d="M0 8H4L5.5 2L7.5 14L9.5 5L11 11H14L15 8H22" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="brand-text">Holterservice</span>
    </a>

    <!-- Nav -->
    <nav aria-label="Glavna navigacija">
      <input type="checkbox" id="nav-toggle" class="nav-toggle" />
      <label for="nav-toggle" class="nav-toggle-label" aria-label="Otvori izbornik">
        <span></span><span></span><span></span>
      </label>
      <!-- The panel is the mobile dropdown. On desktop it is a flex row that is
           allowed to wrap: the tabs hold the first line, the action group drops
           to a second line when the viewport cannot seat all nine items. -->
      <div class="nav-panel">
        <ul class="nav-list">
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class={isActive(item.href) ? 'active' : ''}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <ul class="nav-actions">
          <li>
            <a
              href="/partnerski-portal"
              aria-current={isActive('/partnerski-portal') ? 'page' : undefined}
              class="btn btn-secondary nav-cta nav-cta--portal"
            >Partnerski portal</a>
          </li>
          <li>
            <a href="/za-partnere#kontakt-forma" class="btn btn-primary nav-cta">Postanite partner</a>
          </li>
        </ul>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-height);
    gap: var(--space-4);
  }

  /* ── Brand wordmark ───────────────────────────────────────────────────── */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-foreground);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  .brand:hover { text-decoration: none; color: var(--color-primary); }
  .brand:hover .brand-ecg { color: var(--color-primary); }

  .brand-ecg {
    color: var(--color-primary);
    transition: color 150ms ease;
  }

  /* ── Hamburger (mobile only) ──────────────────────────────────────────── */
  .nav-toggle { display: none; }

  .nav-toggle-label {
    display: inline-flex;
    flex-direction: column;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 8px;
    cursor: pointer;
    justify-content: center;
    border-radius: var(--radius-md);
    transition: background 150ms ease;
  }

  .nav-toggle-label:hover { background: var(--color-muted); }

  .nav-toggle-label span {
    display: block;
    height: 2px;
    background: var(--color-foreground);
    border-radius: 1px;
    transition: transform 200ms ease, opacity 150ms ease;
  }

  .nav-toggle:checked ~ .nav-toggle-label span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle:checked ~ .nav-toggle-label span:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle:checked ~ .nav-toggle-label span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── Mobile dropdown panel ────────────────────────────────────────────── */
  .nav-panel {
    display: none;
    position: absolute;
    top: var(--header-height);
    left: 0;
    right: 0;
    background: #fff;
    border-bottom: 1px solid var(--color-border);
    flex-direction: column;
    padding: var(--space-3) var(--space-3) var(--space-4);
    box-shadow: var(--shadow-lg);
  }

  .nav-toggle:checked ~ .nav-panel { display: flex; }

  .nav-list,
  .nav-actions {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 2px;
  }

  /* Mobile: the action block sits below the tabs, divided from them once so the
     two actions read as one group rather than two sections. */
  .nav-actions {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    gap: var(--space-2);
  }

  .nav-list li,
  .nav-actions li { width: 100%; }

  .nav-list a {
    display: block;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    color: var(--color-foreground);
    text-decoration: none;
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: 0;
  }

  .nav-list a:hover { background: var(--color-muted); color: var(--color-primary); text-decoration: none; }
  .nav-list a.active { background: var(--color-primary-light); color: var(--color-primary); font-weight: 600; }

  .nav-cta { width: 100%; justify-content: center; }

  /* ── Desktop nav ──────────────────────────────────────────────────────────
     Breakpoint is 1024px (VEY-911), replacing the 1140px interim from VEY-910.

     Measured on the built page at 14px type: the brand block is 149.5px and the
     full nine item row is 900.7px, so one line needs a 1131px viewport once the
     container's 2x32px padding is counted. Tightening padding and gaps as far as
     they go without crushing only gets that to 1052px, and 1024px is reachable
     only by also dropping nav type to 13px at 98% fill. Both were rejected.

     Instead the row is allowed to wrap. Brand plus the seven tabs is 750px, so
     the tab line alone is comfortable from a 814px viewport. Above roughly
     1100px everything seats on one line; between 1024px and that point the two
     action buttons drop to a second right aligned line. Nothing is dropped,
     truncated, reordered or shrunk at any width, and below 1024px the hamburger
     still lists all nine entries. */
  @media (min-width: 1024px) {
    .nav-toggle-label { display: none; }

    .nav-panel {
      display: flex !important;
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: flex-end;
      align-items: center;
      background: transparent;
      border: none;
      box-shadow: none;
      padding: 0;
      /* Row gap gives the wrapped action line air; column gap separates the
         tab group from the action group. */
      gap: var(--space-2) var(--space-3);
    }

    .nav-list,
    .nav-actions {
      flex-direction: row;
      align-items: center;
      gap: 2px;
      margin-top: 0;
      padding-top: 0;
      border-top: none;
    }

    .nav-actions { gap: 6px; }

    .nav-list li,
    .nav-actions li { width: auto; }

    .nav-list a {
      display: block;
      padding: 0.5rem 0.6875rem;
      font-size: var(--text-sm);
      font-weight: 500;
      color: var(--color-muted-foreground);
      white-space: nowrap;
    }

    .nav-list a:hover { background: var(--color-muted); color: var(--color-foreground); text-decoration: none; }
    .nav-list a.active { color: var(--color-primary); background: var(--color-primary-light); }

    .nav-cta { width: auto; padding: 0.6rem 0.875rem; }

    /* When the header wraps to two lines it needs vertical breathing room that a
       fixed 4rem min-height cannot give it. */
    .header-inner { padding-block: var(--space-2); }
  }

  /* Keep the CTA button white on its blue fill even when nested under .nav-actions
     (overrides the desktop muted link colour, which has higher specificity than
     the base .btn-primary rule). */
  .nav-actions a.btn-primary {
    color: var(--color-primary-contrast);
  }
  .nav-actions a.btn-primary:hover {
    color: var(--color-primary-contrast);
    background: var(--color-primary-hover, var(--color-primary));
  }

  /* Same specificity fight for the outline action. */
  .nav-actions a.btn-secondary {
    color: var(--color-foreground);
    background: transparent;
  }
  .nav-actions a.btn-secondary:hover {
    color: var(--color-foreground);
    background: var(--color-muted);
    border-color: #c4cedd;
  }

  /* ── Action hierarchy (VEY-911) ───────────────────────────────────────────
     The two header actions are not peers. "Postanite partner" is the conversion
     CTA; "Partnerski portal" is a sign in entry point for partners who already
     converted. Rendered as two same size buttons they competed for the same
     attention. On desktop the portal drops its fill and border and reads as a
     weighted link, so the filled blue button is the only button in the header.
     It keeps its full label, its position and its place in the header, so
     nothing is dropped or truncated. The mobile dropdown keeps both as buttons
     because a full width tap target is the right affordance there. */
  @media (min-width: 1024px) {
    .nav-actions a.nav-cta--portal {
      background: transparent;
      border-color: transparent;
      color: var(--color-foreground);
      font-weight: 600;
      padding: 0.6rem 0.625rem;
    }
    .nav-actions a.nav-cta--portal:hover {
      background: var(--color-muted);
      border-color: transparent;
      color: var(--color-primary);
    }
    /* As a link it can now carry the same current page treatment as a tab,
       which the button form could not show. */
    .nav-actions a.nav-cta--portal[aria-current='page'] {
      color: var(--color-primary);
      background: var(--color-primary-light);
    }
  }
</style>
