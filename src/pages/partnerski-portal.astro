---
import BaseLayout from '../layouts/BaseLayout.astro';

// ─────────────────────────────────────────────────────────────────────────────
// PARTNER SYSTEM TARGETS (VEY-910)
//
// These are the two entry points the founder's original holterservice.eu
// header links to today. The founder will confirm or replace them later, so
// they are kept here as single-line constants: swap the URL and nothing else
// on the page has to change.
// ─────────────────────────────────────────────────────────────────────────────
const SCANLAB_URL = 'https://app.holterservice.eu';
const APPOINTMENTS_URL = 'https://poliklinika-obad.hr/panel/';

const title = 'Partnerski portal';
const description =
  'Pristup sustavima za partnerske ustanove Holterservicea: Liberty Scanlab i Appointments.';
---

<BaseLayout title={title} description={description} path="/partnerski-portal">
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">Za partnerske ustanove</p>
      <h1>Partnerski portal</h1>
      <p class="lede">
        Pristup sustavima za partnerske ustanove. Odaberite sustav u koji se
        želite prijaviti.
      </p>

      <div class="portal-grid">
        <a
          class="card portal-card"
          href={SCANLAB_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="portal-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <rect x="3" y="6" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M7 12h2l1.5-3 2 6 1.5-4L15 12h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <h2>Liberty Scanlab</h2>
          <p>Sustav za snimke i nalaze.</p>
          <span class="portal-go">Otvori sustav →</span>
        </a>

        <a
          class="card portal-card"
          href={APPOINTMENTS_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="portal-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </span>
          <h2>Appointments</h2>
          <p>Kontrolni panel za termine.</p>
          <span class="portal-go">Otvori sustav →</span>
        </a>
      </div>

      <p class="portal-note">
        Nemate pristup? Javite se na
        <a href="mailto:info@holterservice.eu">info@holterservice.eu</a>
        ili preko <a href="/kontakt">kontakt stranice</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .portal-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  @media (min-width: 640px) {
    .portal-grid { grid-template-columns: 1fr 1fr; }
  }

  .portal-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
  }

  .portal-card:hover {
    text-decoration: none;
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .portal-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--color-primary-light);
    color: var(--color-primary);
    margin-bottom: var(--space-4);
  }

  .portal-card h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xl);
  }

  .portal-card p {
    margin: 0 0 var(--space-4);
    color: var(--color-muted-foreground);
    font-size: var(--text-sm);
  }

  .portal-go {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
  }

  .portal-note {
    margin-top: var(--space-8);
    font-size: var(--text-sm);
    color: var(--color-muted-foreground);
  }
</style>
